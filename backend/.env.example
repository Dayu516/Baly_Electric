# ---------- Database ----------
DATABASE_URL=postgresql://ottimo:ottimo@localhost:5432/ottimo
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# ---------- Auth ----------
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---------- Backup ----------
BACKUP_DIR=/backups
BACKUP_RETAIN_DAYS=7

# ---------- App ----------
APP_NAME=OTTIMO
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO